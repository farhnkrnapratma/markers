{
  "name": "@farhnkrnapratma/markers",
  "version": "1.0.0-alpha4",
  "description": "Convert HTML to clean GitHub Flavored Markdown for LLMs. Native addon for Node.js and Bun and WebAssembly for browsers, written in Rust.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.mjs",
      "default": "./index.js"
    },
    "./lazy": {
      "types": "./lazy.d.ts",
      "default": "./lazy.mjs"
    },
    "./wasm": "./wasm/markers_bg.wasm",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/farhnkrnapratma/markers"
  },
  "homepage": "https://github.com/farhnkrnapratma/markers#readme",
  "bugs": {
    "url": "https://github.com/farhnkrnapratma/markers/issues"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "html",
    "markdown",
    "converter",
    "html-to-markdown",
    "gfm",
    "napi-rs",
    "rust"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "browser.mjs",
    "lazy.mjs",
    "lazy.d.ts",
    "wasm/markers.js",
    "wasm/markers.d.ts",
    "wasm/markers_bg.wasm",
    "wasm/markers_bg.wasm.d.ts",
    "wasm/package.json",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "napi": {
    "binaryName": "markers",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "powerpc64le-unknown-linux-gnu",
      "s390x-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "i686-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 14"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features napi",
    "build:debug": "napi build --platform --features napi",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepublishOnly": "napi pre-publish -t npm --no-gh-release",
    "test": "ava",
    "test:wasm": "node scripts/test-wasm.mjs",
    "universal": "napi universalize",
    "version": "napi version",
    "prepare": "bash .githooks/install.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@napi-rs/cli": "^3.11.1",
    "ava": "8.5.0",
    "fallow": "^3.48.0"
  },
  "ava": {
    "files": [
      "tests/**/*.test.js"
    ],
    "timeout": "3m"
  },
  "optionalDependencies": {
    "@farhnkrnapratma/markers-darwin-arm64": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-darwin-x64": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-linux-arm64-gnu": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-linux-arm64-musl": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-linux-x64-gnu": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-linux-x64-musl": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-win32-arm64-msvc": "1.0.0-alpha1",
    "@farhnkrnapratma/markers-win32-x64-msvc": "1.0.0-alpha1"
  },
  "packageManager": "bun@1.4.5",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
